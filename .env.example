# ---------------------------------------------------------------------------
# multi-agent-system environment configuration
# Copy to `.env` and adjust. Defaults work out of the box in mock mode
# (no API key required -- the offline MockLLMClient drives every agent).
# ---------------------------------------------------------------------------

# Real LLM calls only happen when this is set AND llm_provider=openai
OPENAI_API_KEY=sk-xxx

# Which client implementation to build: `mock` (default, offline, deterministic)
# or `openai` (requires OPENAI_API_KEY)
LLM_PROVIDER=mock

# Model used by the OpenAI client
LLM_MODEL=gpt-4o-mini

# Per-call timeout (seconds) and retry policy for transient failures
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2

# Cost / runaway guards (see src/config.py docstrings)
TOKEN_BUDGET=50000          # hard cap per task; exceeding it aborts the run
MAX_CRITIC_ROUNDS=3         # writer<->critic revision loop cap
CRITIC_PASS_SCORE=8         # critic score at/above which the draft is accepted

# FastAPI service
API_HOST=0.0.0.0
API_PORT=8002
